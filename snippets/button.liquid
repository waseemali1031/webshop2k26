{%- liquid
  # Component: Button---123
  # Description: Reusable button with primary/secondary styles, custom colors, and smooth transitions
  # Features: Icon support, custom hover states, responsive sizing
-%}

<div class="section-button" data-section-id="{{ section.id }}">
  
  {%- if section.settings.show_button -%}
    <div class="button-wrapper" data-button-style="{{ section.settings.button_style }}">
      
      <a 
        href="{{ section.settings.button_link }}"
        class="btn btn--{{ section.settings.button_style }}"
        data-component="button"
        aria-label="{{ section.settings.button_text }}"
      >
        
        {%- if section.settings.show_icon -%}
          <span class="btn-icon" data-icon="arrow">
            <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.75 4.77298L6.72657e-08 4.77298L-6.72657e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.219681C20.2145 -0.0732129 19.7396 -0.0732129 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
            </svg>
          </span>
        {%- endif -%}
        
        <span class="btn-text">{{ section.settings.button_text }}</span>
      </a>

    </div>
  {%- endif -%}

</div>

{%- stylesheet -%}
  {% include 'button.css' %}
{%- endstylesheet -%}

{%- javascript -%}
  {% include 'button.js' %}
{%- endjavascript -%}
