{%- liquid
  # Snippet: Button
  # Description: Reusable button component for any section or template
  # Usage: {% include 'button' with button_text: 'Shop Now', button_link: '/shop', button_style: 'primary', show_icon: true %}
  
  # Default parameters if not passed
  assign btn_text = button_text | default: 'Shop Now'
  assign btn_link = button_link | default: '#'
  assign btn_style = button_style | default: 'primary'
  assign show_btn_icon = show_icon | default: true
  
  # Color defaults
  assign primary_bg = primary_bg_color | default: '#000000'
  assign primary_text = primary_text_color | default: '#ffffff'
  assign primary_hover_bg = primary_hover_bg_color | default: '#333333'
  assign primary_hover_text = primary_hover_text_color | default: '#ffffff'
  
  assign secondary_bg = secondary_bg_color | default: '#ffeb00'
  assign secondary_text = secondary_text_color | default: '#000000'
  assign secondary_hover_bg = secondary_hover_bg_color | default: '#ffd700'
  assign secondary_hover_text = secondary_hover_text_color | default: '#000000'
-%}

<style>
  .button-wrapper-{{ section.id }} {
    --btn-primary-bg: {{ primary_bg }};
    --btn-primary-text: {{ primary_text }};
    --btn-primary-hover-bg: {{ primary_hover_bg }};
    --btn-primary-hover-text: {{ primary_hover_text }};
    --btn-secondary-bg: {{ secondary_bg }};
    --btn-secondary-text: {{ secondary_text }};
    --btn-secondary-hover-bg: {{ secondary_hover_bg }};
    --btn-secondary-hover-text: {{ secondary_hover_text }};
  }
</style>

<div class="button-wrapper button-wrapper-{{ section.id }}" data-button-style="{{ btn_style }}">
  <a 
    href="{{ btn_link }}"
    class="btn btn--{{ btn_style }}"
    aria-label="{{ btn_text }}"
  >
    {%- if show_btn_icon -%}
      <span class="btn-icon">
        <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.75 4.77298L6.72657e-08 4.77298L-6.72657e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.219681C20.2145 -0.0732129 19.7396 -0.0732129 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
        </svg>
      </span>
    {%- endif -%}
    <span class="btn-text">{{ btn_text }}</span>
  </a>
</div>
