{%- liquid
  # Component: Button
  # Description: Reusable button with primary/secondary styles, custom colors, and smooth transitions
  # Features: Icon support, custom hover states, responsive sizing
-%}

<div class="section-button" data-section-id="{{ section.id }}">
  
  {%- if section.settings.show_button -%}
    <div class="button-wrapper" data-button-style="{{ section.settings.button_style }}">
      
      <a 
        href="{{ section.settings.button_link }}"
        class="btn btn--{{ section.settings.button_style }}"
        data-component="button"
        aria-label="{{ section.settings.button_text }}"
      >
        
        {%- if section.settings.show_icon -%}
          <span class="btn-icon" data-icon="arrow">
            <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.75 4.77298L6.72657e-08 4.77298L-6.72657e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.219681C20.2145 -0.0732129 19.7396 -0.0732129 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
            </svg>
          </span>
        {%- endif -%}
        
        <span class="btn-text">{{ section.settings.button_text }}</span>
      </a>

    </div>
  {%- endif -%}

</div>

{%- stylesheet -%}
  {% include 'button.css' %}
{%- endstylesheet -%}

{%- javascript -%}
  {% include 'button.js' %}
{%- endjavascript -%}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary (Dark)"
        },
        {
          "value": "secondary",
          "label": "Secondary (Light)"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show Arrow Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors - Primary Style"
    },
    {
      "type": "color",
      "id": "primary_bg_color",
      "label": "Background Color (Default)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "primary_text_color",
      "label": "Text Color (Default)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_hover_bg",
      "label": "Background Color (Hover)",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "primary_hover_text",
      "label": "Text Color (Hover)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Colors - Secondary Style"
    },
    {
      "type": "color",
      "id": "secondary_bg_color",
      "label": "Background Color (Default)",
      "default": "#ffeb00"
    },
    {
      "type": "color",
      "id": "secondary_text_color",
      "label": "Text Color (Default)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "secondary_hover_bg",
      "label": "Background Color (Hover)",
      "default": "#ffd700"
    },
    {
      "type": "color",
      "id": "secondary_hover_text",
      "label": "Text Color (Hover)",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Button - Primary",
      "settings": {
        "button_text": "Shop Now",
        "button_style": "primary"
      }
    },
    {
      "name": "Button - Secondary",
      "settings": {
        "button_text": "Choose Gift",
        "button_style": "secondary"
      }
    }
  ]
}
{% endschema %}