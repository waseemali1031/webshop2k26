{% include 'button' %}
{%- style -%}
  .gift-guide-section {
    padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_side_mobile }}px {{ section.settings.padding_bottom_mobile }}px {{ section.settings.padding_side_mobile }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }
  .gift-guide-container {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap_mobile }}px;
    align-items: center;
    max-width: 100%;
    width: 100%;
  }

  .gift-guide-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    order: 2;
    width: 100%;
  }

  .gift-guide-image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    order: 1;
    width: 100%;
  }

  .gift-guide-image {
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
  }

  .gift-guide-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    line-height: 1.2;
    font-family: {{ section.settings.heading_font_family }};
  }

  .gift-guide-description {
    font-size: {{ section.settings.description_font_size_mobile }}px;
    color: {{ section.settings.description_color }};
    margin: 0 0 {{ section.settings.description_margin_bottom }}px 0;
    line-height: 1.6;
    font-family: {{ section.settings.description_font_family }};
  }

  .gift-guide-button-wrapper {
    display: inline-block;
    margin-top: {{ section.settings.button_margin_top }}px;
  }

  .gift-guide-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: {{ section.settings.button_font_weight }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: {{ section.settings.button_font_family }};
  }

  .gift-guide-button:hover {
    background-color: {{ section.settings.button_bg_hover_color }};
    color: {{ section.settings.button_text_hover_color }};
  }

  .gift-guide-button-arrow {
    display: inline-block;
    font-size: {{ section.settings.button_font_size_mobile }}px;
  }

  /* Tablet Styles */
  @media (min-width: 768px) {
    .gift-guide-section {
      padding: {{ section.settings.padding_top_tablet }}px {{ section.settings.padding_side_tablet }}px {{ section.settings.padding_bottom_tablet }}px {{ section.settings.padding_side_tablet }}px;
    }

    .gift-guide-container {
      flex-direction: row;
      gap: {{ section.settings.gap_tablet }}px;
    }

    .gift-guide-content {
      order: 1;
      flex: 1;
      min-width: 0;
    }

    .gift-guide-image-wrapper {
      order: 2;
      flex: 1;
      min-width: 0;
    }

    .gift-guide-heading {
      font-size: {{ section.settings.heading_font_size_tablet }}px;
    }

    .gift-guide-description {
      font-size: {{ section.settings.description_font_size_tablet }}px;
    }

    .gift-guide-button {
      font-size: {{ section.settings.button_font_size_tablet }}px;
    }
  }

  /* Desktop Styles */
  @media (min-width: 1024px) {
    .gift-guide-section {
      padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_side_desktop }}px {{ section.settings.padding_bottom_desktop }}px {{ section.settings.padding_side_desktop }}px;
    }

    .gift-guide-container {
      flex-direction: row;
      gap: {{ section.settings.gap_desktop }}px;
    }

    .gift-guide-content {
      flex: 1;
      min-width: 0;
    }

    .gift-guide-image-wrapper {
      flex: 1;
      min-width: 0;
    }

    .gift-guide-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .gift-guide-description {
      font-size: {{ section.settings.description_font_size_desktop }}px;
    }

    .gift-guide-button {
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

<section class="gift-guide-section">
  <div class="gift-guide-container">
    <!-- Content Section -->
    <div class="gift-guide-content">
      {% if section.settings.heading %}
        <h1 class="gift-guide-heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description %}
        <p class="gift-guide-description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_text %}
        <div class="gift-guide-button-wrapper">
          <a href="{{ section.settings.button_url }}" class="gift-guide-button">
            <span>{{ section.settings.button_text }}</span>
            <span class="gift-guide-button-arrow">→</span>
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Image Section -->
    <div class="gift-guide-image-wrapper">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'gift-guide-image', alt: section.settings.image.alt }}
      {% else %}
        <div style="background-color: #f0f0f0; width: 100%; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #999;">
          Image not selected
        </div>
      {% endif %}
    </div>
  </div>
</section>

