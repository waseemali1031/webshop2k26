{%- liquid
  # Component: Product Gallery
  # Description: Photo grid built from products picked DIRECTLY (no
  #   collection needed - a product_list setting lets the merchant add
  #   exactly the products they want, in order; however many they add is
  #   however many show, up to 16). Each card's "+" hotspot cycles through
  #   a small set of preset positions automatically (no per-product manual
  #   placement, since the merchant is no longer configuring one block per
  #   product individually). Clicking a hotspot opens a shared quick-add
  #   popup showing that product's real name/price/description/variants,
  #   with dynamic color + size selection and a working Add to Cart.
  # Sections required by the brief: this is the "Grid" section (the "Banner"
  #   is a separate section). Built from scratch - no Dawn ready-made
  #   sections/snippets, only the shared .page-width layout utility and the
  #   existing cta-button.css classes (for visual consistency only; the
  #   button's behaviour here is wired up independently in this section's
  #   own JS, not via the cta-button snippet).
  # No jQuery - vanilla JS only (see product-gallery.js).

  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color
  assign description_limit = section.settings.description_limit
  assign products = section.settings.products
-%}

<section
  class="product-gallery"
  data-section-id="{{ section.id }}"
  data-component="product-gallery"
  data-description-limit="{{ description_limit }}"
>
  <style>
    .product-gallery[data-section-id="{{ section.id }}"] {
      --product-gallery-heading-color: {{ heading_color }};
      --product-gallery-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --product-gallery-padding-top-tablet: {{ section.settings.padding_top_tablet }}px;
      --product-gallery-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --product-gallery-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --product-gallery-padding-bottom-tablet: {{ section.settings.padding_bottom_tablet }}px;
      --product-gallery-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    }
  </style>

  <div class="product-gallery__container page-width">

    {%- if heading != blank -%}
      <h2 class="product-gallery__heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if products.size > 0 -%}
      <div class="product-gallery__grid">
        {%- for product in products -%}
          {%- comment -%}
            Hotspot position cycles through 5 presets by card index, so
            products pulled dynamically from a collection still get some
            visual variety instead of every "+" sitting in the same spot.
          {%- endcomment -%}
          {%- assign hotspot_variant = forloop.index0 | modulo: 5 -%}

          <div class="product-gallery__card">
            <div class="product-gallery__media">
              <img
                class="product-gallery__image"
                src="{{ product.featured_image | image_url: width: 800 }}"
                srcset="
                  {{- product.featured_image | image_url: width: 400 }} 400w,
                  {{ product.featured_image | image_url: width: 800 }} 800w,
                  {{ product.featured_image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 768px) 33vw, 50vw"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                loading="lazy"
              >

              <button
                type="button"
                class="product-gallery__hotspot product-gallery__hotspot--pos-{{ hotspot_variant }}"
                data-action="open-quick-add"
                aria-label="Quick add {{ product.title | escape }}"
                aria-haspopup="dialog"
              >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="16" height="16">
                  <path d="M12 5V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </button>

              {%- comment -%}
                Product data for this card, read by product-gallery.js when
                its hotspot is clicked. Description is stripped of HTML here
                (truncation to data-description-limit happens in JS, at the
                last full word, so it never breaks the popup layout).
              {%- endcomment -%}
              <script type="application/json" data-product-json>
                {
                  "id": {{ product.id | json }},
                  "title": {{ product.title | json }},
                  "url": {{ product.url | json }},
                  "image": {{ product.featured_image | image_url: width: 200 | json }},
                  "description": {{ product.description | strip_html | json }},
                  "optionNames": {{ product.options | json }},
                  "variants": [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id | json }},
                        "available": {{ variant.available | json }},
                        "price": {{ variant.price | money | json }},
                        "options": {{ variant.options | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                }
              </script>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%}
    Single shared popup, reused for whichever product's hotspot was clicked.
    Content below is placeholder structure only - product-gallery.js clears
    and repopulates the dynamic parts (image/title/price/description/color/
    size/button state) each time it opens.
  {%- endcomment -%}
  <div class="product-gallery__overlay" data-quick-add-overlay hidden>
    <div
      class="product-gallery__popup"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ProductGalleryPopupTitle-{{ section.id }}"
      data-quick-add-popup
    >
      <button
        type="button"
        class="product-gallery__popup-close"
        data-action="close-quick-add"
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="18" height="18">
          <path d="M5 5L19 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M19 5L5 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>

      <div class="product-gallery__popup-body">
        <img class="product-gallery__popup-image" data-popup-image src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="" width="120" height="120">

        <div class="product-gallery__popup-info">
          <h3 class="product-gallery__popup-title" id="ProductGalleryPopupTitle-{{ section.id }}" data-popup-title></h3>
          <p class="product-gallery__popup-price" data-popup-price></p>
          <p class="product-gallery__popup-description" data-popup-description></p>

          <div class="product-gallery__popup-option" data-popup-color-wrap hidden>
            <span class="product-gallery__popup-label" data-popup-color-label>Color</span>
            <div class="product-gallery__color-options" data-popup-color-options></div>
          </div>

          <div class="product-gallery__popup-option" data-popup-size-wrap hidden>
            <span class="product-gallery__popup-label" data-popup-size-label>Size</span>
            <div class="product-gallery__dropdown" data-popup-size-dropdown>
              <button
                type="button"
                class="product-gallery__dropdown-toggle"
                data-dropdown-toggle
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span data-dropdown-value>Choose your size</span>
                <span class="product-gallery__dropdown-icon-box">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="14" height="14">
                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </button>
              <ul class="product-gallery__dropdown-list" data-dropdown-list role="listbox" hidden></ul>
            </div>
          </div>

          <p class="product-gallery__popup-status" data-popup-status role="status" aria-live="polite"></p>

          <button
            type="button"
            class="cta-button cta-button--primary cta-button--full product-gallery__add-to-cart"
            data-action="add-to-cart"
          >
            <span data-add-to-cart-label>Add to Cart</span>
            <svg class="cta-button__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path d="M14 6L20 12L14 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{{ 'product-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 16,
      "info": "Add up to 16 products directly - however many you add is however many show."
    },
    {
      "type": "range",
      "id": "description_limit",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "ch",
      "label": "Popup description character limit",
      "default": 120
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (tablet)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (tablet)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product Gallery"
    }
  ]
}
{% endschema %}
